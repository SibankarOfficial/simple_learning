{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-learning.local/schema/topic-lesson.schema.json",
  "title": "Simple Learning topic lesson",
  "type": "object",
  "required": [
    "schemaVersion", "id", "subjectId", "chapterId", "title", "language", "status",
    "reviewedAt", "runtime", "prerequisiteTopicIds", "estimatedMinutes", "objectives",
    "learningFlow", "diagnostic", "sections", "examples", "practice", "interviewQuestions",
    "miniAppIds", "mastery", "sourceIds", "commonMistakes", "publicationChecklist"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "subjectId": { "$ref": "#/$defs/id" },
    "chapterId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "language": { "const": "en" },
    "status": { "enum": ["sample-draft", "published"] },
    "reviewedAt": { "type": "string", "format": "date" },
    "runtime": { "$ref": "#/$defs/text" },
    "prerequisiteTopicIds": { "$ref": "#/$defs/idList" },
    "estimatedMinutes": {
      "type": "object",
      "required": ["firstPass", "practice", "project"],
      "properties": {
        "firstPass": { "type": "integer", "minimum": 1 },
        "practice": { "type": "integer", "minimum": 1 },
        "project": { "type": "integer", "minimum": 1 }
      }
    },
    "objectives": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" } } }
    },
    "learningFlow": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/text" } },
    "diagnostic": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["question", "answer", "ifMissed"], "properties": { "question": { "$ref": "#/$defs/text" }, "answer": { "$ref": "#/$defs/text" }, "ifMissed": { "$ref": "#/$defs/id" } } }
    },
    "sections": {
      "type": "array", "minItems": 3,
      "contains": { "type": "object", "properties": { "depth": { "const": "core" } }, "required": ["depth"] },
      "items": {
        "type": "object", "required": ["id", "title", "depth", "body", "sourceIds", "exampleIds", "objectiveIds"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "depth": { "enum": ["core", "deeper", "reference"] }, "body": { "$ref": "#/$defs/text" }, "sourceIds": { "$ref": "#/$defs/nonEmptyIdList" }, "exampleIds": { "$ref": "#/$defs/idList" }, "objectiveIds": { "$ref": "#/$defs/nonEmptyIdList" } }
      }
    },
    "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/example" } },
    "practice": { "type": "array", "minItems": 5, "maxItems": 10, "items": { "$ref": "#/$defs/exercise" } },
    "interviewQuestions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/interview" } },
    "miniAppIds": { "$ref": "#/$defs/idList" },
    "mastery": {
      "type": "object", "required": ["status", "policy", "checks", "reviewSchedule"],
      "properties": {
        "status": { "const": "not-assessed" }, "policy": { "$ref": "#/$defs/text" },
        "checks": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["id", "evidence", "pass"], "properties": { "id": { "$ref": "#/$defs/id" }, "evidence": { "$ref": "#/$defs/text" }, "pass": { "$ref": "#/$defs/text" } } } },
        "reviewSchedule": {
          "type": "object",
          "required": ["note", "sessions"],
          "properties": {
            "note": { "$ref": "#/$defs/text" },
            "sessions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["dayOffset", "problems"],
                "properties": {
                  "dayOffset": { "type": "integer", "minimum": 1 },
                  "problems": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["id", "prompt", "solution"],
                      "properties": {
                        "id": { "$ref": "#/$defs/id" },
                        "prompt": { "$ref": "#/$defs/text" },
                        "solution": { "$ref": "#/$defs/text" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sourceIds": { "$ref": "#/$defs/nonEmptyIdList" },
    "commonMistakes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["symptom", "cause", "fix"], "properties": { "symptom": { "$ref": "#/$defs/text" }, "cause": { "$ref": "#/$defs/text" }, "fix": { "$ref": "#/$defs/text" } } }
    },
    "publicationChecklist": {
      "type": "object",
      "required": ["authored", "sourcesReviewed", "codeSyntaxChecked", "serverInitialRenderChecked", "browserBehaviorChecked", "independentContentReview", "learnerTrial", "note"],
      "properties": {
        "authored": { "type": "boolean" }, "sourcesReviewed": { "type": "boolean" }, "codeSyntaxChecked": { "type": "boolean" }, "serverInitialRenderChecked": { "type": "boolean" }, "browserBehaviorChecked": { "type": "boolean" }, "independentContentReview": { "type": "boolean" }, "learnerTrial": { "type": "boolean" }, "note": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonEmptyIdList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "example": {
      "type": "object", "required": ["id", "title", "kind", "language", "depth", "code", "explanation", "tryThis", "sourceIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "kind": { "enum": ["module", "fragment"] }, "language": { "enum": ["jsx", "js", "html", "css"] }, "depth": { "enum": ["core", "deeper", "reference"] }, "code": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" }, "tryThis": { "$ref": "#/$defs/text" }, "sourceIds": { "$ref": "#/$defs/nonEmptyIdList" } }
    },
    "solution": {
      "type": "object", "required": ["explanation"],
      "anyOf": [{ "required": ["code"] }, { "required": ["exampleId"] }, { "maxProperties": 1 }],
      "properties": { "explanation": { "$ref": "#/$defs/text" }, "code": { "type": "string" }, "exampleId": { "$ref": "#/$defs/id" }, "language": { "enum": ["jsx", "js", "html", "css"] }, "kind": { "enum": ["module", "fragment"] } }
    },
    "exercise": {
      "type": "object", "required": ["id", "type", "difficulty", "prompt", "hints", "acceptanceCriteria", "objectiveIds", "sourceIds", "solution", "solutionPresentation", "attemptBeforeReveal"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["predict", "build", "debug", "design", "explain-and-build", "transfer"] }, "difficulty": { "enum": ["beginner", "intermediate", "advanced"] }, "prompt": { "$ref": "#/$defs/text" }, "hints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "objectiveIds": { "$ref": "#/$defs/nonEmptyIdList" }, "sourceIds": { "$ref": "#/$defs/nonEmptyIdList" }, "solution": { "$ref": "#/$defs/solution" }, "solutionPresentation": { "const": "modal" }, "attemptBeforeReveal": { "const": true } }
    },
    "interview": {
      "type": "object", "required": ["id", "question", "answer", "followUp", "type", "provenance", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "question": { "$ref": "#/$defs/text" }, "answer": { "$ref": "#/$defs/text" }, "followUp": { "$ref": "#/$defs/text" }, "type": { "enum": ["original-interview-style", "recorded-interview"] }, "sourceIds": { "$ref": "#/$defs/nonEmptyIdList" },
        "provenance": { "type": "object", "required": ["kind", "recordedInterview", "company", "interviewSourceUrl"], "properties": { "kind": { "enum": ["original", "public-record"] }, "recordedInterview": { "type": "boolean" }, "company": { "type": ["string", "null"] }, "interviewSourceUrl": { "type": ["string", "null"], "format": "uri" }, "interviewSourceDate": { "type": ["string", "null"], "format": "date" } } }
      }
    }
  }
}
